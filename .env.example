# ============================================
# CONFIGURATION DU BOT - Dragflow
# Copier ce fichier en ".env" et remplir les valeurs
# ============================================

# Token du bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# ID de l'application/du client Discord
CLIENT_ID=

# Préfixe par défaut utilisé si un serveur n'en a pas encore défini un
DEFAULT_PREFIX=+

# Couleur principale des embeds (hex)
EMBED_COLOR=#3498DB
EMBED_COLOR_SUCCESS=#2ECC71
EMBED_COLOR_ERROR=#E74C3C
EMBED_COLOR_WARNING=#F1C40F

# Liste des IDs propriétaires du bot, séparés par des virgules
OWNER_IDS=

# ============================================
# BASE DE DONNÉES
# ============================================
# Dialecte : "postgres" en production, "sqlite" possible en développement local
DB_DIALECT=postgres

# URL complète de connexion PostgreSQL (prioritaire si renseignée)
# Exemple : postgres://user:password@localhost:5432/dragflow
DATABASE_URL=

# Alternative : connexion détaillée (utilisée si DATABASE_URL est vide)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dragflow
DB_USER=postgres
DB_PASSWORD=

# Chemin du fichier SQLite (uniquement si DB_DIALECT=sqlite)
SQLITE_STORAGE=./data/database.sqlite

# ============================================
# LOGS TECHNIQUES (erreurs internes envoyées au staff)
# ============================================
# Salon Discord où les erreurs techniques (stack traces) seront envoyées
ERROR_LOG_CHANNEL_ID=

# Serveur Discord de support du bot (utilisé par +support, +invite, etc.)
SUPPORT_SERVER_INVITE=

# ============================================
# APIS EXTERNES (optionnelles, utilisées par certaines commandes Fun/Utile)
# ============================================
# Exemples de clés à ajouter au fur et à mesure des phases suivantes :
# CAT_API_KEY=
# TRANSLATE_API_KEY=
# SHORTURL_API_KEY=

# ============================================
# DIVERS
# ============================================
NODE_ENV=development

# ============================================
# DASHBOARD WEB (optionnel — le bot fonctionne normalement sans ces variables)
# ============================================
# Mettre à "false" pour désactiver complètement le dashboard
DASHBOARD_ENABLED=true

# Port d'écoute de l'API du dashboard (backend Express intégré au bot)
DASHBOARD_PORT=3001

# URL du frontend du dashboard (pour CORS et les redirections OAuth2)
DASHBOARD_URL=http://localhost:5173

# Application Discord OAuth2 (Developer Portal > OAuth2)
# Peut être la MÊME application que le bot (CLIENT_ID), ou une application dédiée.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à une "Redirect URI" enregistrée sur le Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Secret utilisé pour signer les cookies de session (générer une chaîne aléatoire longue)
SESSION_SECRET=

